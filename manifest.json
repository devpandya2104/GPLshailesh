{
  "manifest_version": 3,
  "name": "GPL \u2014 GuestPostLinks Order Tracker",
  "version": "27.1.0",
  "description": "GPL v27.1 \u2014 GuestPostLinks Order Tracker. Built-in API config, doc-title matching for same-domain bulk orders, live link to client sheet.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "*://app.missiveapp.com/*",
    "*://mail.missiveapp.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://api.notion.com/*",
    "https://www.paypal.com/*",
    "https://api.paypal.com/*"
  ],
  "action": {
    "default_title": "GPL \u2014 GuestPostLinks Order Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://app.missiveapp.com/*",
        "*://mail.missiveapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}